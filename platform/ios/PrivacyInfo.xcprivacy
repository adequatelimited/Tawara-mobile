<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tawara's privacy manifest. release.sh copies it to the root of Tawara.app.

     Required-reason APIs, from the imports of the aarch64-apple-ios release
     binary (nm -u):
     - stat, lstat, fstat and fstatat read metadata of the store's files under
       Library/Application Support/Tawara in the app's own container: reason
       C617.1, "access timestamps, size, or metadata for files in the app
       container".
     - mach_absolute_time and mach_timebase_info, which Rust's Instant uses to
       measure elapsed time: reason 35F9.1.
     Not imported, so not declared: the disk-space calls (statfs, statvfs, the
     volume-capacity attributes of getattrlist), NSUserDefaults, and the
     active-keyboard API. clock_gettime, imported by the standard library,
     has no required-reason category and is not declared.

     NSPrivacyTracking is false: the app does not link user data with other
     companies' apps or websites for advertising, and has no tracking domains.

     NSPrivacyCollectedDataTypes is empty: the app runs no analytics or crash
     reporting, and sends only the requests the user makes to the node they
     choose (default https://api.mochimo.org). The App Store Connect privacy
     answers must agree with this file.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
